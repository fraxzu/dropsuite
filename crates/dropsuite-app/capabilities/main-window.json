{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main DropSuite window may read captured history, start or stop the local listener, change its loopback port, and move, resize, minimize, maximize, fullscreen or close itself. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-get-status",
    "allow-list-history",
    "allow-get-transaction",
    "allow-get-transaction-unredacted",
    "allow-start-proxy",
    "allow-stop-proxy",
    "allow-get-listener-settings",
    "allow-set-listener-port",
    "allow-send-replay",
    "allow-cancel-replay",
    "allow-get-https-settings",
    "allow-set-https-allowlist",
    "allow-generate-ca-certificate",
    "allow-remove-ca-certificate",
    "allow-export-ca-certificate",
    "allow-get-intercept-status",
    "allow-set-intercept-enabled",
    "allow-set-intercept-requests",
    "allow-set-intercept-responses",
    "allow-list-intercepted-messages",
    "allow-forward-intercepted-message",
    "allow-drop-intercepted-message",
    "allow-forward-all-intercepted",
    "allow-drop-all-intercepted",
    "allow-get-repeater-tabs",
    "allow-save-repeater-tab",
    "allow-delete-repeater-tab",
    "allow-list-repeater-attempts",
    "allow-save-repeater-attempt",
    "allow-clear-repeater-attempts",
    "allow-export-history-har",
    "allow-clear-history",
    "allow-get-app-info",
    "allow-open-app-folder",
    "allow-get-start-at-login",
    "allow-set-start-at-login",
    "allow-check-for-update",
    "allow-open-release-page",
    "allow-download-update",
    "allow-install-and-restart",
    "allow-get-scope-config",
    "allow-set-scope-config",
    "allow-get-match-replace-config",
    "allow-set-match-replace-config",
    "allow-get-sitemap",
    "allow-start-intruder",
    "allow-get-intruder-status",
    "allow-list-intruder-results",
    "allow-cancel-intruder",
    "allow-get-dropai-config",
    "allow-set-dropai-config",
    "allow-set-dropai-key",
    "allow-clear-dropai-key",
    "allow-dropai-complete",
    "allow-test-dropai",
    "allow-list-dropai-models",
    "allow-open-embedded-browser",
    "allow-list-cookies",
    "allow-list-cookies-for-host",
    "allow-save-cookie",
    "allow-delete-cookie",
    "allow-clear-cookies",
    "allow-get-apply-settings",
    "allow-set-apply-settings",
    "allow-start-active-scan",
    "allow-open-challenge-browser",
    "allow-import-challenge-cookies",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
